{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openopenrouter",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["enable_request_signal"],
  // Self-hosters: replace with your own account ID (or remove and use `wrangler login`).
  "account_id": "46223d4b4026a2d3f8cc17e0835f6319",

  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/v1/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "openopenrouter",
      // Self-hosters: `wrangler d1 create openopenrouter` and paste the ID here.
      "database_id": "21e3a02a-92c7-4491-83bb-090609b6b402",
      "migrations_dir": "migrations"
    }
  ],

  "ratelimits": [
    // Per API key, for inference endpoints.
    { "name": "KEY_LIMITER", "namespace_id": "71001", "simple": { "limit": 600, "period": 60 } },
    // Per signed-in user, for the dashboard API.
    { "name": "DASHBOARD_LIMITER", "namespace_id": "71002", "simple": { "limit": 120, "period": 60 } }
  ],

  "vars": {
    "SITE_NAME": "OpenOpenRouter",
    "PUBLIC_URL": "https://openopenrouter.ai",
    "HEXCLAVE_API_URL": "https://api.hexclave.com",
    "HEXCLAVE_PROJECT_ID": "36184c6c-88cb-44ed-bb32-6a3465b72038",
    "SIGNUP_CREDITS_USD": "0"
  },
  // Secrets (set with `wrangler secret put <NAME>`):
  //   HEXCLAVE_SECRET_SERVER_KEY, OPENAI_API_KEY, ANTHROPIC_API_KEY

  "routes": [{ "pattern": "openopenrouter.ai", "custom_domain": true }],
  "triggers": { "crons": ["17 3 * * *"] },
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
